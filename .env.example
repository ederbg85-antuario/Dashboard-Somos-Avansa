# ------------------------------------------------------------------
# avansa · sistema integral — variables de entorno
# Copia este archivo a .env.local y llena los valores.
# ------------------------------------------------------------------

# --- Supabase (obligatorio) ---------------------------------------
# Panel de Supabase -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://vbvycgwxhsoaqionyrgc.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# El panel NO usa la clave de servicio: toda la autorización vive en las
# políticas RLS de la base y el cliente entra con la sesión de la persona.
# Si algún día se agrega una tarea de servidor que deba saltarse RLS,
# esa clave va aquí y NUNCA con el prefijo NEXT_PUBLIC_.

# --- Zona horaria --------------------------------------------------
# Node hace todo el cálculo de fechas con la zona del proceso. En Vercel el
# contenedor arranca en UTC, y sin esto un lead de las 20:00 en México
# aparecería al día siguiente.
TZ=America/Mexico_City
