# ------------------------------------------------------------------
# avansa · sistema integral — variables de entorno
# Copia este archivo a .env.local y llena los valores.
# ------------------------------------------------------------------

# --- Supabase (obligatorio) ---------------------------------------
# Panel de Supabase -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://vbvycgwxhsoaqionyrgc.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_DASHBOARD_URL=https://dashboard.somosavansa.com

# Sólo procesos de servidor: envío de invitaciones Auth y RPC cerrados para el
# webhook o la resincronización de Chatwoot. Las vistas normales del dashboard
# usan la sesión y RLS con la clave pública de arriba. Nunca lleva NEXT_PUBLIC_
# ni se importa desde componentes del navegador.
SUPABASE_SERVICE_ROLE_KEY=

# --- Zona horaria --------------------------------------------------
# Node hace todo el cálculo de fechas con la zona del proceso. En Vercel el
# contenedor arranca en UTC, y sin esto un lead de las 20:00 en México
# aparecería al día siguiente.
TZ=America/Mexico_City

# --- Chatwoot (bandeja de conversaciones) --------------------------
# El módulo de Conversaciones habla con Chatwoot desde el servidor. Ninguna
# de estas variables lleva NEXT_PUBLIC_: el token puede leer y responder toda
# la bandeja, así que jamás debe llegar al navegador.
#
# CHATWOOT_TOKEN tiene que ser el token de un **agente dedicado** que exista
# sólo en la cuenta de avansa. No sirve un token de bot —Chatwoot los rechaza
# en estos endpoints con "not authorized for bots"— y no conviene el token
# personal del dueño, que es administrador de todas las cuentas de la
# instancia: si se filtrara, se filtrarían también las otras empresas.
#
# Se saca en: Chatwoot -> (cuenta avansa) -> perfil del agente -> Access Token.
CHATWOOT_URL=https://chat.antuario.mx
CHATWOOT_TOKEN=
CHATWOOT_CUENTA_ID=3
# Bandeja a la que se limita el panel. Hoy es la de pruebas; al conectar el
# número real de WhatsApp hay que cambiarla por la nueva.
CHATWOOT_BANDEJA_ID=4

# Secreto que Chatwoot muestra al crear el webhook. El endpoint comprueba las
# cabeceras X-Chatwoot-Signature y X-Chatwoot-Timestamp sobre el cuerpo crudo;
# nunca se agrega el secreto a la URL.
CHATWOOT_WEBHOOK_SECRET=

# El número, Phone Number ID, WABA ID y token permanente de WhatsApp Cloud API
# se configuran en la bandeja de WhatsApp de Chatwoot y en Meta Developers, no
# como variables de este dashboard. Cuando exista el número definitivo,
# sustituye CHATWOOT_BANDEJA_ID por la bandeja real antes de activar el webhook.

# --- Meta Ads (métricas de campañas; opcional) -------------------
# Token de sistema con ads_read y cuenta publicitaria con o sin prefijo act_.
# Son secretos de servidor y no tienen relación con el Pixel/CAPI del sitio.
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=
META_API_VERSION=v23.0

# --- Google Analytics + Search Console (sólo lectura) -------------------
# Un cliente OAuth del proyecto exclusivo "Avansa Dashboard". El refresh
# token se guarda sólo en Supabase con RLS cerrado, tras pulsar "Conectar
# Google" dentro de Marketing; no copies tokens aquí ni al navegador.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GA4_PROPERTY_ID=550792301
SEARCH_CONSOLE_SITE_URL=https://www.somosavansa.com/
# Opcional: si falta, se deriva de NEXT_PUBLIC_DASHBOARD_URL.
GOOGLE_OAUTH_REDIRECT_URI=https://dashboard.somosavansa.com/api/integraciones/google/callback

# --- Publicación social con Meta (permisos oficiales requeridos) ------------
# La app se asocia únicamente al portafolio "Somos Avansa". Nunca uses un
# token personal en producción: crea un token técnico de sistema con el mínimo
# de permisos de contenido, independiente del token de lectura de Ads.
META_PAGE_ID=
META_INSTAGRAM_ACCOUNT_ID=
META_CONTENT_ACCESS_TOKEN=
