# ------------------------------------------------------------------
# avansa · sistema integral — variables de entorno
# Copia este archivo a .env.local y llena los valores.
# ------------------------------------------------------------------

# --- Supabase (obligatorio) ---------------------------------------
# Panel de Supabase -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://vbvycgwxhsoaqionyrgc.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_DASHBOARD_URL=https://dashboard.somosavansa.com

# Sólo procesos de servidor: invitaciones Auth, webhook/sincronización de
# Chatwoot y lecturas administrativas acotadas. Nunca lleva NEXT_PUBLIC_ ni se
# importa desde componentes del navegador.
SUPABASE_SERVICE_ROLE_KEY=

# --- Zona horaria --------------------------------------------------
# Node hace todo el cálculo de fechas con la zona del proceso. En Vercel el
# contenedor arranca en UTC, y sin esto un lead de las 20:00 en México
# aparecería al día siguiente.
TZ=America/Mexico_City

# --- Chatwoot (bandeja de conversaciones) --------------------------
# El módulo de Conversaciones habla con Chatwoot desde el servidor. Ninguna
# de estas variables lleva NEXT_PUBLIC_: el token puede leer y responder toda
# la bandeja, así que jamás debe llegar al navegador.
#
# CHATWOOT_TOKEN tiene que ser el token de un **agente dedicado** que exista
# sólo en la cuenta de avansa. No sirve un token de bot —Chatwoot los rechaza
# en estos endpoints con "not authorized for bots"— y no conviene el token
# personal del dueño, que es administrador de todas las cuentas de la
# instancia: si se filtrara, se filtrarían también las otras empresas.
#
# Se saca en: Chatwoot -> (cuenta avansa) -> perfil del agente -> Access Token.
CHATWOOT_URL=https://chat.antuario.mx
CHATWOOT_TOKEN=
CHATWOOT_CUENTA_ID=3
# Bandeja a la que se limita el panel. Hoy es la de pruebas; al conectar el
# número real de WhatsApp hay que cambiarla por la nueva.
CHATWOOT_BANDEJA_ID=4

# Secreto que Chatwoot muestra al crear el webhook. El endpoint comprueba las
# cabeceras X-Chatwoot-Signature y X-Chatwoot-Timestamp sobre el cuerpo crudo;
# nunca se agrega el secreto a la URL.
CHATWOOT_WEBHOOK_SECRET=
